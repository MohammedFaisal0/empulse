SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use SQLite. Set for PostgreSQL in production:
# DATABASE_URL=postgres://user:password@localhost:5432/empulse
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Path to the ml/ package (empulse_ml.py + models/*.pkl). Defaults to <repo>/ml.
# ML_DIR=D:/Projects_all/empulse/ml
# Managers may run a limited team simulation only when HR enables this (default off).
ALLOW_MANAGER_TEAM_SIMULATE=False
# Optional. When set, PulseAI may use Gemini only for tool picking + phrasing
# aggregated tool JSON (never raw rows). Leave blank for rule-based fallback.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
